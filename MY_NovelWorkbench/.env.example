# ============================================================
# MY_NovelWorkbench 环境变量模板
# 使用：复制本文件为 .env 并填入自己的 Key（.env 不入库）
# ============================================================

# ---- AI Provider（OpenAI 兼容协议，M3 接入）----
# 说明：实际配置将在应用内「设置 → AI Provider」管理（本地加密存储），
# 此处仅用于开发期联调默认值，可留空。

# 默认 Provider 的 Base URL（OpenAI 兼容端点）
# 示例：DeepSeek=https://api.deepseek.com  智谱=https://open.bigmodel.cn/api/paas/v4  Ollama=http://localhost:11434/v1
NOVEL_LLM_BASE_URL=

# 默认 Provider 的 API Key
NOVEL_LLM_API_KEY=

# 默认模型名
NOVEL_LLM_MODEL=
